{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Publish to GitHub",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short",
				"--branch"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Initialize Git repository",
			"type": "shell",
			"command": "git",
			"args": [
				"init",
				"-b",
				"main"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Stage files",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"--all"
			],
			"isBackground": false,
			"group": "build"
		}
	]
}